fun merge(inpArr:Array<IntArray>):MutableList<IntArray>{
    inpArr.sortBy{it[0]}
    val outPut=mutableListOf<IntArray>() 
    var previous=inpArr[0]
      for(i in 1 .. inpArr.size-1){
       val current=inpArr[i]
         if(previous[1]>current[0]){
             previous=intArrayOf(previous[0],maxOf(previous[1],current[1]))
          }
          else{
           outPut.add(previous ) 
           previous=current
          }
   
    }
    outPut.add(previous)   

return outPut
}
