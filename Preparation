//BuySell
    val arr = intArrayOf(7, 1, 5, 3, 6, 4)
fun buySell(inp:IntArray):Int{
    var minPrice=inp[0]
    var maxProfit=0
    for(i in  1 until inp.size){
        val profit=inp[i]-minPrice
        maxProfit=maxOf(maxProfit,profit)
        minPrice=minOf(minPrice,inp[i])
    }
    return maxProfit
}
Time: O(n)
Space: O(1)
// validate paranthesis
    val str = "({[]})"
fun isValid(inp: String): Boolean {
    val stack=ArrayDeque<Char>()
     for(i in inp){
         when(i){
             '(','[','{' -> stack.addLast(i)
             '}'->{if( stack.isEmpty()||stack.removeLast()!=('{')) return false}
			']'->{if( stack.isEmpty()||stack.removeLast()!=('[')) return false}
			')'->{if( stack.isEmpty()||stack.removeLast()!=('(')) return false}
         }
     } 
    return stack.isEmpty()
}
Time: O(n)
Space: O(1)

//merge arr
fun mergeSortedArrays(
    arr1: IntArray,
    arr2: IntArray
): IntArray {
    val result = IntArray(arr1.size + arr2.size)
    var i = 0
    var j = 0
    var k = 0
    while (i < arr1.size && j < arr2.size) {
        if (arr1[i] <= arr2[j]) {
            result[k++] = arr1[i++]
        } else {
            result[k++] = arr2[j++]
        }
    }
    // Copy remaining elements from arr1
    while (i < arr1.size) {
        result[k++] = arr1[i++]
    }
    // Copy remaining elements from arr2
    while (j < arr2.size) {
        result[k++] = arr2[j++]
    }
    return result
}
Time: O(n + m)
Space: O(n + m)
