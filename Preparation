// group annagram 
["eat", "tea", "tan", "ate", "nat", "bat"]
fun getGroupAnagram(inp:List<String>):List<List<String>>{
 val mapAna=HashMap<String,MutableList<String>>()
 for(i in inp){
     val anaKey= i.toCharArray().sorted().joinToString("")
     mapAna.getOrPut(anaKey) {mutableListOf()}.add(i)
 }
 
return mapAna.map{it.value}   
}
// Non Repeting 
1 Input: "aabbcddee" Output: 'c'
2 Input: "aabb" Output: null
fun firstNonRepeating(inp:String):Char?{
val setStr=HashMap<Char,Int>()
 for(i in inp){
     setStr[i]=setStr.getOrDefault(i,0)+1
 }
 for(i in inp){
     if(setStr[i]==1){
         return i
     }
 }
return null  
}
// secondLargestDistinct
1 Input:  [10, 5, 20, 8, 20] Output: 10
2 Input:  [5, 5, 5] output null
3 Input: [Int.MIN_VALUE,2] out put -2147483648
fun secondLargestDistinct(inp:IntArray):Int?{
var largest:Int?=null
var secondLargest:Int?=null
 for(i in inp){
     if(largest == null || i>largest){
		secondLargest=largest  
        largest=i}
     else if( i<largest && (secondLargest == null  || i>secondLargest )){
        secondLargest=i   
     }
 }
return secondLargest 
}
//twoSum
inp = intArrayOf(2, 7, 11, 15)
target = 9
fun twoSum(inp:IntArray,target:Int):Pair<Int,Int>?{
val mapItem=HashMap<Int,Int>()
 for((i,item) in inp.withIndex()){
     val complement=target-item
     if(complement in mapItem){
	  return Pair(i,mapItem[complement]!!)
     }
     mapItem[item]=i
 }
return null 
}
//find duplicate
1 Input:  intArrayOf(1, 2, 3, 2, 4, 1, 5) Output: [2, 1]
fun findduplicate(inp:IntArray):List<Int>{
val mapItem=HashMap<Int,Int>()
 for(i in inp){
     mapItem[i]=mapItem.getOrDefault(i,0)+1
 }
return mapItem.filter{it.value>1}.map{it.key} 
}
Time complexity	O(n) average
Space complexity	O(n)
//longestConsecutive
  val arr = intArrayOf(100, 4, 200, 1, 3, 2)

fun longestConsecutive(inp:IntArray):Int{
    var longest=0
    val numSet = inp.toHashSet()
    for(i in numSet){
        if(i-1 !in numSet){
			 var currentNo=i
       		 var currentLength=1
             while(currentNo+1 in numSet){
              currentNo+=1
             currentLength++  
             }
             longest=maxOf(longest,currentLength)
        }
    }
    return longest
}
//productExceptSelf
fun productExceptSelf(inp:IntArray):IntArray{
 val result=IntArray(inp.size)
  result[0]=1
 for(i in 1 until inp.size){
  result[i]=result[i-1]*inp[i-1]
 }
 var right=1
 for(i in inp.size-1 downTo 0){
     result[i]*=right
     right*=inp[i]   
 }
 return result
}
Time: O(n) average
Space: O(n)
