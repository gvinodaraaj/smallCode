// reverse word
fun reversWord(inp:CharArray){
    var start=0
   revers(inp,0,inp.size-1)
  for(i in 0 .. inp.size-1){
      if(inp[i]==' '){
         revers(inp,start,i-1) 
         start=i+1
      }
  }
   revers(inp,start,inp.size-1)
}
Complexity: O(n) time, O(1) extra space.

