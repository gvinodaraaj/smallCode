target = 9
fun twoSum(inp:IntArray,target:Int):Pair<Int,Int>?{
val mapItem=HashMap<Int,Int>()
 for((i,item) in inp.withIndex()){
     val complement=target-item
     if(complement in mapItem){
	  return Pair(i,mapItem[complement]!!)
     }
     mapItem[item]=i
 }
return null 
}
//find duplicate
1 Input:  intArrayOf(1, 2, 3, 2, 4, 1, 5) Output: [2, 1]
fun findduplicate(inp:IntArray):List<Int>{
val mapItem=HashMap<Int,Int>()
 for(i in inp){
     mapItem[i]=mapItem.getOrDefault(i,0)+1
 }
return mapItem.filter{it.value>1}.map{it.key} 
}
Time complexity	O(n) average
Space complexity	O(n)
//longestConsecutive
  val arr = intArrayOf(100, 4, 200, 1, 3, 2)

fun longestConsecutive(inp:IntArray):Int{
    var longest=0
    val numSet = inp.toHashSet()
    for(i in numSet){
        if(i-1 !in numSet){
			 var currentNo=i
       		 var currentLength=1
             while(currentNo+1 in numSet){
              currentNo+=1
             currentLength++  
             }
             longest=maxOf(longest,currentLength)
        }
    }
    return longest
}
fun longestSubstring(str:String):Int{
    var longestStrLength=0
    for(i in 0 .. str.length-1){
      val setStr=HashSet<Char>()
        var l=i
        var cuttentLength=0
        while(l<str.length){
        if(setStr.add(str[l])){
           cuttentLength++ 
        }else{
          break
        }
          longestStrLength=maxOf(longestStrLength,cuttentLength) 
        l++
        }
    }
    return longestStrLength
}
//productExceptSelf
fun productExceptSelf(inp:IntArray):IntArray{
 val result=IntArray(inp.size)
  result[0]=1
 for(i in 1 until inp.size){
  result[i]=result[i-1]*inp[i-1]
 }
 var right=1
 for(i in inp.size-1 downTo 0){
     result[i]*=right
     right*=inp[i]   
 }
 return result
}
Time: O(n) average
Space: O(n)
