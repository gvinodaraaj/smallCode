fun firstNonRepeating(inp:String):Char?{
val setStr=HashMap<Char,Int>()
 for(i in inp){
     setStr[i]=setStr.getOrDefault(i,0)+1
 }
 for(i in inp){
     if(setStr[i]==1){
         return i
     }
 }
return null  
}
// secondLargestDistinct
1 Input:  [10, 5, 20, 8, 20] Output: 10
2 Input:  [5, 5, 5] output null
3 Input: [Int.MIN_VALUE,2] out put -2147483648
fun secondLargestDistinct(inp:IntArray):Int?{
var largest:Int?=null
var secondLargest:Int?=null
 for(i in inp){
     if(largest == null || i>largest){
		secondLargest=largest  
        largest=i}
     else if( i<largest && (secondLargest == null  || i>secondLargest )){
        secondLargest=i   
     }
 }
return secondLargest 
}
